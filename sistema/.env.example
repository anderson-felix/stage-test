# Chave de instalação: só é pedida no primeiro acesso, para criar o administrador do hub.
# Depois cada pessoa entra com o próprio e-mail e senha (tela Usuários).
HUB_PASSWORD=troque-esta-chave
# Segredo para assinar o cookie de sessão (32+ caracteres)
HUB_SECRET=gere-com-node-crypto-randomBytes-32-hex
# Pasta do workspace de marketing (TatuOS) que o Claude usa como contexto
WORKSPACE_DIR=C:/caminho/para/Stage-Marketing
# Pasta de dados do hub (usuários). Padrão: ./data
# DATA_DIR=
# Site monitorado na Visão Geral
SITE_URL=https://stage.consulting
# Opcional: caminho do Claude Code. Sem isso, usa o do PATH ou o da extensão do VS Code.
# CLAUDE_BIN=
# Servidor / time: com a chave definida, o Claude passa a cobrar pela API em vez da conta pessoal
# ANTHROPIC_API_KEY=
# Opcional: força o cookie "Secure" (1) ou não (0). Padrão: só em produção.
# COOKIE_SECURE=

# Navegador do Playwright (render da Arte e leitura do Instagram). No Windows com Smart App Control
# ligado, o Chromium do Playwright é bloqueado: use o Edge instalado. Vazio = Chromium (servidor).
# PLAYWRIGHT_CHANNEL=msedge

# --- Só no servidor (docker compose) ---
# Endereço do hub. Sem domínio próprio: <ip-com-hifens>.sslip.io, ex.: 203-0-113-10.sslip.io
# HUB_HOST=
