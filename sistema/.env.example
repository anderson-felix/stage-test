# ==============================================================================
# STAGE HUB SAAS MULTI-TENANT — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# --- 1. Banco de Dados PostgreSQL (Prisma ORM) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stage_hub?schema=public"

# --- 2. Cache & Rate-Limiting Redis ---
REDIS_URL="redis://localhost:6379"

# --- 3. Segurança, Autenticação JWT e Criptografia ---
# Segredo para assinar o JWT de sessão (mínimo 32 caracteres)
JWT_SECRET="gere-com-node-crypto-randomBytes-32-hex"
HUB_SECRET="gere-com-node-crypto-randomBytes-32-hex"
# Senha de bootstrap inicial para o primeiro administrador
HUB_PASSWORD="troque-esta-chave-inicial"
# Segredo dedicado para criptografia AES-256-GCM dos tokens OAuth sociais
SOCIAL_TOKEN_SECRET="gere-com-node-crypto-randomBytes-32-hex"

# --- 4. Domínios Multi-Tenant & Azure Front Door ---
# Domínio principal do painel SaaS
NEXT_PUBLIC_APP_DOMAIN="app.stage.consult"
# Alvo CNAME para os subdomínios customizados de Landing Pages dos tenants
CNAME_TARGET="domains.stage.consult"
# Credenciais opcionais do Azure Resource Manager para provisionamento automático no Azure Front Door
# AZURE_TENANT_ID=""
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_SUBSCRIPTION_ID=""
# AZURE_RESOURCE_GROUP=""
# AZURE_FRONTDOOR_PROFILE=""
# AZURE_FRONTDOOR_ENDPOINT=""
# AZURE_FRONTDOOR_ORIGIN_GROUP=""
# AZURE_FRONTDOOR_ROUTE=""

# --- 5. Motor de IA (@anthropic-ai/sdk) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- 6. Armazenamento Azure Blob Storage ---
# Em desenvolvimento local sem esta string, usa fallback em disco (.blob-local)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_MEDIA="tenant-media"
AZURE_STORAGE_CONTAINER_LPS="published-lps"

# --- 7. Mensageria Assíncrona Azure Service Bus ---
AZURE_SERVICE_BUS_CONNECTION_STRING=""
AZURE_SERVICE_BUS_LEAD_QUEUE="lead-notifications"
AZURE_SERVICE_BUS_RENDER_QUEUE="slide-renders"

# --- 8. E-mail Transacional Self-Service (Resend API) ---
RESEND_MASTER_API_KEY=""
STAGE_FALLBACK_SENDER="Stage Leads <leads@stage.consult>"

# --- 9. Redes Sociais OAuth 2.0 (Meta Graph API & LinkedIn API) ---
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- 10. Workspace Legado / Seed & Playwright ---
WORKSPACE_DIR="../cerebro"
SITE_URL="https://stage.consulting"
# No Windows com Smart App Control ligado, use "msedge". Em Linux/Container, deixe vazio para Chromium.
# PLAYWRIGHT_CHANNEL="msedge"
