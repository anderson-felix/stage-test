# ==============================================================================
# STAGE HUB SAAS MULTI-TENANT — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# --- 1. Banco de Dados PostgreSQL (Prisma ORM) ---
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/stage_hub?schema=public"

# --- 2. Cache & Rate-Limiting Redis ---
REDIS_URL="redis://redis:6379"

# --- 3. Segurança, Autenticação JWT e Criptografia ---
# Segredo para assinar o JWT de sessão (mínimo 32 caracteres)
JWT_SECRET="gere-com-node-crypto-randomBytes-32-hex"
HUB_SECRET="gere-com-node-crypto-randomBytes-32-hex"
# Senha de bootstrap inicial para o primeiro administrador
HUB_PASSWORD="troque-esta-chave-inicial"
# Segredo dedicado para criptografia AES-256-GCM dos tokens OAuth sociais
SOCIAL_TOKEN_SECRET="gere-com-node-crypto-randomBytes-32-hex"
# Atributo Secure do cookie de sessão (padrão "1" em produção; use "0" apenas como exceção
# temporária enquanto APP_BASE_URL operar em HTTP pelo IP da VM, sem alterar NODE_ENV=production)
COOKIE_SECURE="0"

# --- 4. Painel SaaS, Roteamento de Domínios & TLS na VM ---
# Host canônico do painel SaaS (lido em runtime pelo src/proxy.ts)
APP_PANEL_HOST="172.212.145.134"
# URL base do painel SaaS (em HTTP temporariamente pelo IP público da VM)
APP_BASE_URL="http://172.212.145.134"
# Modo de apontamento DNS dos domínios de clientes ("direct-ip" ou "cname")
DOMAIN_ROUTING_MODE="direct-ip"
# IPv4 público estático da VM para apontamento de domínios de clientes
DOMAIN_TARGET_IPV4="172.212.145.134"
# Provedor TLS responsável pelos certificados de domínios customizados ("caddy" | "frontdoor" | "manual")
DOMAIN_TLS_PROVIDER="caddy"
# Desativa o subdomínio fallback (*.lp.stage.consult) quando não há DNS curinga apontado
LP_FALLBACK_ENABLED="false"
# Define se o app aceita X-Forwarded-Host / X-Forwarded-Proto de um reverse proxy confiável ("1" ou "0")
TRUSTED_PROXY="1"
# Destino TLS fixado por topologia no Compose; não copiar um override de loopback para o worker.
# Definido pelo Compose escolhido: caddy ou host.docker.internal.
# CADDY_TLS_PROBE_HOST=
# CADDY_TLS_PROBE_PORT=443
# Compatibilidade legada (opcional; use apenas APP_PANEL_HOST e APP_BASE_URL como fonte única):
# NEXT_PUBLIC_APP_DOMAIN=""
# NEXT_PUBLIC_APP_URL=""
# HUB_HOST=""
# CNAME_TARGET="domains.stage.consult"

# --- 5. Motor de IA (@anthropic-ai/sdk) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- 6. Armazenamento Azure Blob Storage (Produção & Homologação) ---
# Obrigatório: container privado com prefixos por tenant ({tenantId}/{category}/{yyyy-mm}/{filename}) e leitura pelo backend
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="stage-media"

# --- 7. Mensageria Assíncrona Azure Service Bus ---
AZURE_SERVICE_BUS_CONNECTION_STRING=""
AZURE_SERVICE_BUS_LEAD_QUEUE="lead-notifications"
AZURE_SERVICE_BUS_RENDER_QUEUE="slide-renders"

# --- 8. E-mail Transacional Self-Service (Resend API) ---
RESEND_MASTER_API_KEY=""
# Somente se o domínio deste remetente estiver autorizado na conta Resend:
STAGE_FALLBACK_FROM_EMAIL=""

# --- 9. Redes Sociais OAuth 2.0 (Meta Graph API & LinkedIn API) ---
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- 10. Workspace Legado / Seed & Playwright ---
WORKSPACE_DIR="../cerebro"
SITE_URL="https://stage.consulting"
# No Windows com Smart App Control ligado, use "msedge". Em Linux/Container, deixe vazio para Chromium.
# PLAYWRIGHT_CHANNEL="msedge"
