# Complemento de .env.example para Caddy no host (web/worker em Docker).
TRUSTED_PROXY=1
CADDY_TLS_PROBE_HOST=host.docker.internal
CADDY_TLS_PROBE_PORT=443
# O Compose resolve esse alias por host-gateway em Docker Linux.
# Caddy deve escutar 443 na interface do gateway, não apenas em loopback.
# Backend web continua publicado somente em 127.0.0.1:3000.
