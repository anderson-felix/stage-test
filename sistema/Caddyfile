{
	# Emissão dinâmica de TLS sob demanda para domínios customizados de clientes
	on_demand_tls {
		interval 2m
		burst 5
	}
}

:80, :443 {
	tls {
		on_demand
	}

	encode zstd gzip

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		# Gerações de IA e SSE/NDJSON transmitidos em tempo real sem buffer
		flush_interval -1
	}
}
